# Every component the cluster runs, pinned. Images by digest, downloads by checksum; scripts and workflows read
# this file and nothing else, so a bump is one line here and the cluster workflow proves it. A release is adopted
# only once it is 14 days old.

KIND_VERSION=v0.33.0
KIND_SHA256_LINUX_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
KIND_CONTEXT=kind-iab

# The model servers: the llm-d vLLM simulator (no GPUs). It serves the OpenAI API and publishes vLLM's own metrics.
SIM_IMAGE=ghcr.io/llm-d/llm-d-inference-sim:v1.0.0@sha256:1908c421cbb44130a3212934a0dd1e279dacfe3480be93f4c28b45cd29b93ec8

# The metrics path the Horizontal Pod Autoscaler reads, as production clusters build it: Prometheus scrapes the pods,
# recording rules turn their metrics into one series per signal, and prometheus-adapter serves those series through
# the custom metrics API.
PROMETHEUS_VERSION=v3.15.0
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
PROMETHEUS_ADAPTER_VERSION=v0.12.0
PROMETHEUS_ADAPTER_IMAGE=registry.k8s.io/prometheus-adapter/prometheus-adapter:v0.12.0@sha256:932eae60e2bcf9c4660d6442da066ef1a79b4ea7cc232c61c7303069216ca006

# KEDA, the other way to scale on the same signals: its operator queries Prometheus itself and serves the result through
# the external metrics API to an HPA it creates, with no prometheus-adapter in the path. Installed from the release's
# manifest, checked by checksum, with its three images swapped for these digests (scripts/deploy-keda.sh). KEDA 2.21
# is tested on Kubernetes 1.34 to 1.36; the node image is 1.37, and the cluster workflow's KEDA smoke test is the check.
KEDA_VERSION=v2.21.0
KEDA_MANIFEST_SHA256=b43c89ffeef81722d7e2dd2c079d74789767a0f89cae1336cff784994814f6d7
KEDA_IMAGE=ghcr.io/kedacore/keda:2.21.0@sha256:81fe6547ce8d1cc29273f887b76507e9b853e5bc1f875ec23fe60061a38ed809
KEDA_METRICS_APISERVER_IMAGE=ghcr.io/kedacore/keda-metrics-apiserver:2.21.0@sha256:255375037fe592732eeb554743aae360c2da88cf0b9b1258d0a987ef885f0881
KEDA_ADMISSION_WEBHOOKS_IMAGE=ghcr.io/kedacore/keda-admission-webhooks:2.21.0@sha256:e1969628cca6123e32eea13c47c75817091af2657fa68d9d0d58a8620d1b75b1

# The load client's image is built from Dockerfile on this base.
PYTHON_IMAGE=docker.io/library/python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
